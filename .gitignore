**/*.pth
**/*.safetensors
**/*.onnx

# Run logs (keep requirements*.txt and other tracked .txt)
out_*.txt
nohup.out
*.log

# --- Payloads: NEVER commit live malware or decoded bits ---
# Only payloads/synthetic/ (inert substitutes) and payloads/MANIFEST.sha256
# are tracked. Everything below is forbidden.
payloads/*.zip
payloads/*.bin
payloads/decoded/
payloads/originals/
